NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only. Never prefix with NEXT_PUBLIC_ — this key bypasses RLS entirely.
# Get it from Dashboard > Project Settings > API > service_role, and paste it
# here yourself; it must not travel through chat or version control.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email and SMS, added in Phase 02.
RESEND_API_KEY=
SMS_PROVIDER_KEY=
