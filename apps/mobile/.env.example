# Publishable values only — these ship inside the app binary and are public by
# design. RLS is what protects the data, never the key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
EXPO_PUBLIC_TENANT_ID=your-tenant-uuid
EXPO_PUBLIC_TENANT_SLUG=pxlpod
EXPO_PUBLIC_WEB_URL=https://your-web-app.com

# Facebook Messenger deep link for the Book Us screen, e.g. https://m.me/YourPage
EXPO_PUBLIC_MESSENGER_URL=
