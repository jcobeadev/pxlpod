{
  "expo": {
    "name": "PxlPod",
    "slug": "pxlpod",
    "scheme": "pxlpod",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-media-library",
        {
          "savePhotosPermissionTextIOS": "PxlPod saves your finished strip to your photos.",
          "photosPermissionTextIOS": "PxlPod needs access to save your photo strip.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0E0E0C",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E0E0C"
          }
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jcobea.pxlpod",
      "infoPlist": {
        "NSCameraUsageDescription": "PxlPod uses your camera to take your photo strip.",
        "NSPhotoLibraryAddUsageDescription": "PxlPod saves your finished strip to your photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jcobea.pxlpod",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "d966c7f6-5af7-424c-8f3c-59e8aeea084a"
      },
      "router": {}
    }
  }
}
