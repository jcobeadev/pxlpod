{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "pxlpod"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "pxlpod"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TENANT_SLUG": "pxlpod"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "53HHS3Z88H",
        "appleId": "APPLE_ID_EMAIL_HERE",
        "ascAppId": "APP_STORE_CONNECT_APP_ID_HERE"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
